{
  "pipeline": {
    "num_variations": 1,
    "batch_mode": false,
    "batch_size": 1
  },
  "assets_dir": "assets",
  "story": {
    "target_story_duration_minutes": 9,
    "chapter_word_target": 118,
    "chapter_word_min": 100,
    "chapter_word_max": 130,
    "chapters_min": 10,
    "chapters_max": 13
  },
  "clip": {
    "min_length_seconds": 42,
    "max_length_seconds": 50,
    "speed_variation_min": 0.98,
    "speed_variation_max": 1.02,
    "zoom_variation_px": 8,
    "zoom_pulse_interval_seconds": 5,
    "zoom_pulse_scale": 1.015
  },
  "script": {
    "min_words": 100,
    "max_words": 130,
    "max_regeneration_attempts": 3,
    "intensity_level": 3,
    "tone": "15-year-old venting to phone camera at 11pm, emotional, raw, real",
    "ollama_model": "gpt-oss:120b-cloud"
  },
  "voiceover": {
    "target_duration_seconds": 45,
    "max_duration_seconds": 50,
    "speed_min": 0.98,
    "speed_max": 1.02,
    "max_speed_override": 1.06,
    "voice_ids": [
      "rachel",
      "bella",
      "elli",
      "nicole"
    ],
    "output_format": "mp3"
  },
  "subtitles": {
    "presets": {
      "default": {
        "fontsize": 84,
        "font": "Arial-Bold",
        "color": "white",
        "stroke_color": "black",
        "stroke_width": 4,
        "words_per_group": 2,
        "bg_color": null
      },
      "hype": {
        "fontsize": 90,
        "font": "Arial-Bold",
        "color": "#FFFF00",
        "stroke_color": "black",
        "stroke_width": 5,
        "words_per_group": 2
      },
      "sadness": {
        "fontsize": 84,
        "font": "Arial-Bold",
        "color": "#88CCFF",
        "stroke_color": "black",
        "stroke_width": 4,
        "words_per_group": 2
      },
      "rage": {
        "fontsize": 90,
        "font": "Arial-Bold",
        "color": "#FF4444",
        "stroke_color": "black",
        "stroke_width": 5,
        "words_per_group": 2
      },
      "romantic": {
        "fontsize": 88,
        "font": "Arial-Bold",
        "color": "#FF88CC",
        "stroke_color": "black",
        "stroke_width": 4,
        "words_per_group": 2
      },
      "heartbreak": {
        "fontsize": 90,
        "font": "Arial-Bold",
        "color": "#AA44FF",
        "stroke_color": "black",
        "stroke_width": 5,
        "words_per_group": 2
      },
      "tension": {
        "fontsize": 90,
        "font": "Arial-Bold",
        "color": "#FF8800",
        "stroke_color": "black",
        "stroke_width": 5,
        "words_per_group": 2
      }
    },
    "active_preset": "default",
    "timing_variation_ms": 60,
    "hook_overlay_duration_seconds": 1.5,
    "hook_overlay_fontsize": 88,
    "hook_overlay_color": "#FFFF00",
    "subtitle_position_y_ratio": 0.78
  },
  "memes": {
    "enable_memes": true,
    "max_memes_per_video": 2,
    "meme_display_duration": 1.2
  },
  "sfx": {
    "enable_sfx": true,
    "sfx_volume": 0.13,
    "max_sfx_duration": 2.0,
    "max_sfx_per_video": 3
  },
  "music": {
    "enabled": false,
    "volume": 0.06,
    "file": "assets/bgm.mp3"
  },
  "output": {
    "min_video_length": 38,
    "max_video_length": 55,
    "resolution_width": 1080,
    "resolution_height": 1920,
    "fps": 60,
    "video_bitrate": "12000k",
    "audio_bitrate": "256k",
    "exports_folder": "exports",
    "log_file": "logs/story_pipeline_log.csv"
  },
  "retention": {
    "pattern_interrupt_enabled": true,
    "pattern_interrupt_time": 3.0
  },
  "validation": {
    "min_video_length": 35,
    "max_video_length": 55
  }
}